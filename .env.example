# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Standard Google Maps Platform API key (required for autocomplete and reverse-geocoding).
GOOGLE_MAPS_API_KEY=

# GOOGLE_MAPS_PLATFORM_KEY: Alternative environment variable name for the Google Maps API Key.
GOOGLE_MAPS_PLATFORM_KEY=

# VITE_GOOGLE_CLIENT_ID: Optional. External Google Identity Services Client ID (OAuth 2.0). 
# If provided, the app will execute authentic Google One-Tap or authorization popups seamlessly.
VITE_GOOGLE_CLIENT_ID=

# FIREBASE_WEB_API_KEY: Optional. The Firebase Web API Key for standard auth operations.
# Overrides firebaseConfig.apiKey in server-side REST requests if provided.
FIREBASE_WEB_API_KEY=

# SMTP email delivery configuration for custom password reset delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@example.com"

# CRON_SECRET: Secure token for triggering the /api/cron/check-gigs endpoint externally
CRON_SECRET=

