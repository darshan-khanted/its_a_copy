{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.cjs",
    "migrate": "tsx server/migrations/cli.ts run",
    "migrate:dry-run": "tsx server/migrations/cli.ts run --dry-run",
    "migrate:status": "tsx server/migrations/cli.ts status",
    "migrate:list": "tsx server/migrations/cli.ts list",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "type-check:server": "tsc -p tsconfig.server.json --noEmit",
    "type-check:all": "npm run type-check && npm run type-check:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:ci": "npm run verify:bundle && npm run type-check:all && npm run build",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:rules": "vitest run --project rules --passWithNoTests",
    "test:rules:emulated": "firebase emulators:exec --only firestore,storage --project qwick-gig-rules-test 'npm run test:rules'",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:property": "vitest run --project property --passWithNoTests"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@vis.gl/react-google-maps": "^1.8.3",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.344.0",
    "motion": "^11.11.17",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.22.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "^4.10.2",
    "fast-check": "^3.23.1",
    "firebase-tools": "^15.24.0",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^2.1.8"
  }
}
